# Copy this file to .streamlit/secrets.toml and set your own credentials
# before a real presentation, if you don't want the built-in demo
# username/password (student / riskwise2026) visible.
#
# secrets.toml itself should NEVER be committed to a public GitHub repo —
# it's listed in .gitignore for exactly that reason. This .example file
# (no real secrets) is safe to commit.

[auth]
username = "your_username_here"
password = "your_password_here"
